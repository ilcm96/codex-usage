FROM --platform=$BUILDPLATFORM golang:1.26.4-trixie AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY docs ./docs
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/codex-usage-api ./cmd/codex-usage-api \
	&& CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/codex-usage-backfill-patch-stats ./cmd/codex-usage-backfill-patch-stats

FROM alpine:3.22.4

RUN addgroup -S codexusage \
	&& adduser -S -G codexusage codexusage \
	&& mkdir -p /var/lib/codex-usage/raw \
	&& chown -R codexusage:codexusage /var/lib/codex-usage

COPY --from=builder /out/codex-usage-api /usr/local/bin/codex-usage-api
COPY --from=builder /out/codex-usage-backfill-patch-stats /usr/local/bin/codex-usage-backfill-patch-stats

USER codexusage

ENV CODEX_USAGE_ADDR=:8080 \
	CODEX_USAGE_RAW_DIR=/var/lib/codex-usage/raw

EXPOSE 8080

ENTRYPOINT ["codex-usage-api"]
